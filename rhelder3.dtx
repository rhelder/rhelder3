\NewCommandCopy\MakeUppercaseCopy\MakeUppercase

\RenewDocumentCommand{\MakeUppercase}{m}{
  \group_begin:
    \addfontfeature{LetterSpace = 9.0}
    \MakeUppercaseCopy{#1}
  \group_end:
}
%    \end{macrocode}
% \end{imacro}
%
% \begin{imacro}{\digits}
%    Letterspace strings of digits
%    (good for strings of three or more digits).
%    \begin{macrocode}
\NewDocumentCommand{\digits}{m}{
  \group_begin:
    \addfontfeature{LetterSpace = 4.0}
    #1
  \group_end:
}
%    \end{macrocode}
% \end{imacro}
%
% Small caps should also be letterspaced;
% this should be specified
% in the current font's \pkg{fontspec} configuration.

