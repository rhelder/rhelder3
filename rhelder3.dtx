% \section{Headings \& Subheads}
%
% \begin{imacro}{
%   \section,
%   \subsection,
%   \subsubsection,
%   \paragraph,
%   \subparagraph
% }
%    Define all of the headings and subheads defined in the standard classes.
%    \begin{macrocode}
% TODO: define function for defining headings and subheads
\newcommand\section{
  \@startsection{section}{1}
  {0pt}
  {
    -\fp_to_dim:n {
      (3\g_@@_normal_leading_dim - \g_@@_large_leading_dim) / 2.701 * 1.701
    }
  }
  {
    \fp_to_dim:n {
      (3\g_@@_normal_leading_dim - \g_@@_large_leading_dim) / 2.701 * 1
    }
  }
  {
    \savepos\RecordProperties{rh@ypos@\thesection}{ypos}
    \headfamily\scshape\large
  }
}

\newcommand\subsection{
  \@startsection{subsection}{2}
  {0pt}
  {
    -\fp_to_dim:n {
      (2\g_@@_normal_leading_dim - \g_@@_normal_leading_dim) / 2.701 * 1.701
    }
  }
  {
    \fp_to_dim:n {
      (2\g_@@_normal_leading_dim - \g_@@_normal_leading_dim) / 2.701 * 1
    }
  }
  {
    \savepos\RecordProperties{rh@ypos@\thesubsection}{ypos}
    \rmfamily\scshape\normalsize
  }
}

\newcommand\subsubsection{
  \@startsection{subsubsection}{3}
  {0pt}
  {
    -\fp_to_dim:n {
      (2\g_@@_normal_leading_dim - \g_@@_normal_leading_dim) / 2.701 * 1.701
    }
  }
  {
    \fp_to_dim:n {
      (2\g_@@_normal_leading_dim - \g_@@_normal_leading_dim) / 2.701 * 1
    }
  }
  {
    \savepos\RecordProperties{rh@ypos@\thesubsubsection}{ypos}
    \rmfamily\itshape\normalsize
  }
}

\newcommand\paragraph{
  \@startsection{paragraph}{4}
  {0pt}
  {\g_@@_normal_leading_dim}
  {-1em}
  {\rmfamily\bfseries\normalsize}
}

\newcommand\subparagraph{
  \@startsection{subparagraph}{5}
  {0pt}
  {\g_@@_normal_leading_dim}
  {-1em}
  {\rmfamily\itshape\normalsize}
}
%    \end{macrocode}
% \end{imacro}

