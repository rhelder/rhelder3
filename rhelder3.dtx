%    \begin{macrocode}
\NewDocumentEnvironment{abstract}{+b}{
  \vbox_set:Nn \l_tmpa_box {
    \small
    \begin{center}
      \itshape\abstractname
    \end{center}
    \begin{quotation}
      #1
    \end{quotation}
  }

  \dim_set:Nn \l_tmpa_dim {\box_ht_plus_dp:N \l_tmpa_box}
  \box_use_drop:N \l_tmpa_box
  \skip_vertical:n {
    \fp_eval:n {ceil(\l_tmpa_dim / \baselineskip, 0)}\baselineskip
    - \l_tmpa_dim
  }
}{
  \legacy_if_gset_true:n {@nobreak}
}
%    \end{macrocode}
% \end{environment}

% \subsection{\env{enumerate}}
%
% \begin{lmacro}{\theenumi, \theenumii, \theenumiii, \theenumiv}
%    Define how the enumerate counters are represented.
%    \begin{macrocode}
\cs_set:Npn \theenumi {\arabic{enumi}}
\cs_set:Npn \theenumii {\alph{enumii}}
\cs_set:Npn \theenumiii {\roman{enumiii}}
\cs_set:Npn \theenumiv {\Alph{enumiv}}
%    \end{macrocode}
% \end{lmacro}

% \begin{lmacro}{\labelenumi, \labelenumii, \labelenumiii, \labelenumiv}
%    Define the label for each item.
%    \begin{macrocode}
\cs_new_protected:Npn \labelenumi {\tabularfigures\theenumi}
\cs_new_protected:Npn \labelenumii {\theenumii}
\cs_new_protected:Npn \labelenumiii {\theenumiii}
\cs_new_protected:Npn \labelenumiv {\theenumiv}
%    \end{macrocode}
% \end{lmacro}

% \begin{lmacro}{\p@enumii, \p@enumiii, \p@enumiv}
%    Define the prefix of the output of a \tn{ref} command
%    when referencing an item of the Nth level of an enumerated list.
%    The overall output of the \tn{ref} command will be
%    \verb+\p@enumN\theenumN+.
%    \begin{macrocode}
\cs_set:Npn \p@enumi {}
\cs_set:Npn \p@enumii {\theenumi.}
\cs_set:Npn \p@enumiii {\p@enumii.\theenumii.}
\cs_set:Npn \p@enumiv {\p@enumiii.\theenumiii.}
%    \end{macrocode}
% \end{lmacro}

% \subsection{\env{itemize}}
%
% \begin{lmacro}{\labelitemi, \labelitemii, \labelitemiii, \labelitemiv}
%    Define the label for each item.
%    \begin{macrocode}
\cs_new_protected:Npn \labelitemi {\labelitemfont\textbullet}
\cs_new_protected:Npn \labelitemii {\labelitemfont\ding{"76}}
\cs_new_protected:Npn \labelitemiii {\labelitemfont\ding{"42}}
\cs_new_protected:Npn \labelitemiv {\labelitemfont\ding{"5B}}
%    \end{macrocode}
% \end{lmacro}

% \begin{lmacro}{\labelitemfont}
%    Defines the font to use in the \env{itemize} label.
%    \begin{macrocode}
\cs_new_protected:Npn \labelitemfont {\normalfont}
%    \end{macrocode}
% \end{lmacro}

% \subsection{\env{description}}
%
% \begin{environment}{description}
%    While \env{enumerate} and \env{itemize}
%    are defined in the \LaTeX{} format,
%    \env{description} needs to be defined here.
%
%    This definition is borrowed from the \LaTeX{} standard classes.
%    TODO: revisit, rewrite in expl3, and tweak
%    \begin{macrocode}
\newenvironment{description}{
  \list{}{
    % Arbitrary for now; just set to satisfy the tests after making all list
    % parameters local
    \labelsep 10.824pt\relax
    \labelwidth\z@ \itemindent-\leftmargin
    \let\makelabel\descriptionlabel
  }
}{
  \endlist
}
%    \end{macrocode}
% \end{environment}

% \begin{lmacro}{\descriptionlabel}
%    Defines the formatting of the \env{description} label.
%
%    This definition is borrowed from the \LaTeX{} standard classes.
%    \begin{macrocode}
\newcommand*\descriptionlabel[1]{
  \hspace\labelsep
  \normalfont\bfseries #1
}
%    \end{macrocode}
% \end{lmacro}

% \begin{lmacro}{\trivlist}
%    Prepend \tn{@listi} to \tn{trivlist}
%    so that the changes to \tn{@listi} made by size-changing commands
%    affect \env{trivlist}-based environments
%    like \env{center} or \env{flushright}.
%    \begin{macrocode}
\group_begin:
  % rescan is necessary because \trivlist contains parameter tokens
  \tl_set_rescan:NnV \l_tmpa_tl {} \trivlist
  \tl_put_left:Nn \l_tmpa_tl {\@listi}
  \exp_args:NNV \cs_gset:Npn \trivlist \l_tmpa_tl
\group_end:
%    \end{macrocode}
% \end{lmacro}

% \section{Headings \& Subheads}
%
% \begin{imacro}{\section}
%    Defines the top-level heading used in this class.
%
%    This heading takes up three leads of vertical space in total.
%    The space before the heading is one lead,
%    consistent with the subheadings,
%    and the space after the heading is a little smaller,
%    which looks attractive.
%    Let the space after the heading stretch to one lead,
%    so that subsequent text can snap to baseline
%    if the heading is sitting at the top of a page
%    (if \TeX{} is trying to fill that page, at any rate).
%    \begin{macrocode}
\dim_new:N \c_section_afterskip

\dim_set:Nn \c_section_afterskip {
  3\c_@@_normal_leading_dim
  - \c_@@_normal_leading_dim
  - \c_@@_large_leading_dim
}

\NewDocumentCommand{\section}{}{
  \@startsection{section}{1}{0pt}
    {-\c_@@_normal_leading_dim}
    {
      \c_section_afterskip
      plus \dim_eval:n {\c_@@_normal_leading_dim - \c_section_afterskip}
    }
    {\headfamily\scshape\large}
}
%    \end{macrocode}
%
%    Tell \TeX{} to align the text with the bottom of the text block.
%    Because there are no other rubber lengths in this document class
%    and all of the the other lengths are in units of one lead,
%    this will incentivize \TeX{} to stretch the space after this heading
%    to return the text to baseline
%    where nececessary.
%    \begin{macrocode}
\flushbottom
%    \end{macrocode}
% \end{imacro}

% \begin{imacro}{\subsection, \subsubsection, \paragraph, \subparagraph}
% Define the remaining subheadings provided by the standard classes.
%
% These headings also take up three leads of vertical space in total.
% So that the subsequent text always returns to baseline,
% surround the display headings with one lead of vertical space
% before and after.
%
% As a result of this design,
% the subsequent text will return to baseline
% even if the headings are nested.
%    \begin{macrocode}
\NewDocumentCommand{\subsection}{}{
  \@startsection{subsection}{2}{0pt}
    {-\c_@@_normal_leading_dim}{\c_@@_normal_leading_dim}
    {\rmfamily\scshape\normalsize}
}

\NewDocumentCommand{\subsubsection}{}{
  \@startsection{subsubsection}{3}{0pt}
    {-\c_@@_normal_leading_dim}{\c_@@_normal_leading_dim}
    {\rmfamily\itshape\normalsize}
}

\NewDocumentCommand{\paragraph}{}{
  \@startsection{paragraph}{4}{0pt}
    {\c_@@_normal_leading_dim}{-1em}{\rmfamily\bfseries\normalsize}
}

\NewDocumentCommand{\subparagraph}{}{
  \@startsection{subparagraph}{5}{0pt}
    {\c_@@_normal_leading_dim}{-1em}{\rmfamily\itshape\normalsize}
}
%    \end{macrocode}
% \end{imacro}

% \begin{lcounter}{secnumdepth}
%    Number all headings down to \tn{subsubsection}.
%    \begin{macrocode}
\setcounter{secnumdepth}{3}
%    \end{macrocode}
% \end{lcounter}

% \begin{lcounter}{
%   section,
%   subsection,
%   subsubsection,
%   paragraph,
%   subparagraph,
% }
%    Define counters used for section numbers.
%    \begin{macrocode}
\newcounter{section}
\newcounter{subsection}[section]
\newcounter{subsubsection}[subsection]
\newcounter{paragraph}[subsubsection]
\newcounter{subparagraph}[paragraph]
%    \end{macrocode}
% \end{lcounter}

% \begin{imacro}{
%   \thesection,
%   \thesubsection,
%   \thesubsubsection,
%   \theparagraph,
%   \thesubparagraph
% }
%    Format section numbers.
%    \begin{macrocode}
\cs_set:Npn \thesection {\arabic{section}}
\cs_set:Npn \thesubsection {\thesection.\arabic{subsection}}
\cs_set:Npn \thesubsubsection {\thesubsection.\arabic{subsubsection}}
\cs_set:Npn \theparagraph {\thesubsubsection.\arabic{paragraph}}
\cs_set:Npn \thesubparagraph {\theparagraph.\arabic{subparagraph}}

\cs_set_protected:Npn \@seccntformat #1 {\normalfont\cs:w the#1\cs_end:\quad}
%    \end{macrocode}
% \end{imacro}

% \section{Footnotes}
%
% \begin{lmacro}{\@makefnmark}
%    Generates the footnote mark.
%    Use superior figures rather than superscript.
%    \begin{macrocode}
\cs_set_protected:Npn \@makefnmark {
  \hbox:n {\normalfont\sufigures\@thefnmark}
}
%    \end{macrocode}
% \end{lmacro}

% \begin{lmacro}{\@makefntext}
%    \marg{text}\\
%    Called by \LaTeX{}'s \tn{footnote} and friends
%    to typeset the actual footnote.
%    Typesets the footnote label one \tn{parindent} into the left margin.
%
%    \tn{parskip} is set to \num{0}\unit{pt}
%    by \tn{@parboxrestore},
%    which is invoked before \tn{@makefntext} in \tn{@footnotetext},
%    so place the footnote mark in a box of size \tn{baselineskip},
%    which is what \tn{parindent} is supposed to be.
%    \begin{macrocode}
\cs_new_protected:Npn \@makefntext #1 {
  % Enter horizontal mode, so that a new paragraph isn't created between the
  % marker and the footnote text
  \noindent
  \hbox_overlap_left:n {
    \hbox_to_wd:nn {\baselineskip}{\normalfont\@thefnmark\hss}
  }#1
}
%    \end{macrocode}
% \end{lmacro}
%
% \begin{imacro}{\footnoterule}
%    Suppress the footnote rule.
%    \begin{macrocode}
\cs_set:Npn \footnoterule {}
%    \end{macrocode}
% \end{imacro}
%
% \begin{ldimen}{\footnotesep}
%    Affects the height of the box containing the footnote text
%    by setting the height of a strut
%    placed at the beginning of every footnote.
%    The depth of the box containing the footnote text
%    is determined by the depth of a strut
%    placed at the end of every footnote,
%    which is \num{0.3}\tn{baselineskip}.
%    To get a total height of \tn{baselineskip},
%    the first strut needs to have a height of \num{0.7}\tn{baselineskip}.
%    If the height of the first strut
%    is less than \num{0.7}\tn{baselineskip},
%    there is less lead than normal between footnotes
%    (or between the footnote rule and the first footnote).
%    If the height of the first strut
%    is more than \num{0.7}\tn{baselineskip},
%    there will be more lead than normal between footnotes
%    (or between the footnote rule and the first footnote).
%    Set \tn{footnotesep} to \num{0.7}\tn{baselineskip}
%    for uniform leading throughout the footnote block.
%    \begin{macrocode}
\dim_set:Nn \footnotesep {0.7\c_@@_footnote_leading_dim}
%    \end{macrocode}
% \end{ldimen}
%
% \begin{lskip}{\skip\bslash footins}
%    Determines the distance between the main text
%    and the start of the footnotes.
%    Requires at least one full \tn{baselineskip}
%    between the main text and the start of the footnotes
%    (15pt + 3pt to align the footnote text,
%    which has a leading of 12pt,
%    with the bottom of the text block).
%    \begin{macrocode}
\skip_set:Nn {\skip\footins} {
  \skip_eval:n {
    \c_@@_normal_leading_dim +
    (\c_@@_normal_leading_dim - \c_@@_footnote_leading_dim)
  }
  plus \c_@@_normal_leading_dim
}
%    \end{macrocode}
% \end{lskip}
%

% \section{Markup}
%
% \begin{imacro}{\initials}
%    Typesets initials with a hair space between each initial.
%    The unstarred form makes the subsequent space an interword space,
%    and the starred form makes the subsequent space and intersentence space
%    (which should be rarely needed).
%    \begin{macrocode}
\NewDocumentCommand{\initials}{>{\SplitList{.}} m}{
  \tl_map_inline:nn {#1}{
    \tl_set:Nn \l_tmpa_tl {##1}
    \tl_if_empty:NTF \l_tmpa_tl {
      \unkern\@
    }{
      \tl_use:N \l_tmpa_tl .\hairspace
    }
  }
}
%    \end{macrocode}
% \end{imacro}

% \begin{imacro}{\acro}
%    Typesets acronyms with letterspaced small caps.
%    \begin{macrocode}
\NewDocumentCommand{\acro}{m}{\textsc{\MakeLowercase{#1}}}
%    \end{macrocode}
% \end{imacro}

