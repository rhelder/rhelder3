% \section{Font}
%
% Configure \acro{EB} Garamond.
%    \begin{macrocode}
%</class>
%<*ebgaramond>
\defaultfontfeatures[EBGaramond]{
  Extension = .otf,
  UprightFont = *-Regular,
  ItalicFont = *-Italic,
  BoldFont = *-SemiBold,
  BoldItalicFont = *-SemiBoldItalic,
%    \end{macrocode}
%
% Use text figures by default.
%    \begin{macrocode}
  Numbers = {Proportional, OldStyle},
%    \end{macrocode}
%
% Set up Swash font.
%    \begin{macrocode}
  FontFace = {m}{sw}{Font = *-Italic, Style = Swash},
  FontFace = {b}{sw}{Font = *-SemiBoldItalic, Style = Swash},
  FontFace = {m}{scsw}{Font = *-Italic, Letters = SmallCaps, Style = Swash},
%    \end{macrocode}
%
% Letterspace small caps,
% and use small caps even for uppercase letters.
%    \begin{macrocode}
  SmallCapsFeatures = {Letters = UppercaseSmallCaps, LetterSpace = 2.0},
}
%</ebgaramond>
%<*class>
%    \end{macrocode}

% \begin{imacro}{\headfamily}
%    Use Cormorant Garamond,
%    which is lighter than \acro{EB} Garamond,
%    as a display font.
%    \begin{macrocode}
\newfontfamily{\headfamily}{CormorantGaramond}[
  SmallCapsFeatures = {Letters = UppercaseSmallCaps, LetterSpace = 2.0},
]
%    \end{macrocode}
% \end{imacro}

% \begin{imacro}{\initfamily, \textinit}
%    Switches to \acro{EB} Garamond's font face
%    with decorative initials.
