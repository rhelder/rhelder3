% \begin{variable}{
%   \g_@@_maketitle_title,
%   \g_@@_maketitle_author,
%   \g_@@_maketitle_date,
% }
%    Internal variables to be used by \tn{maketitle}.
%    \begin{macrocode}
\tl_new:N \g_@@_maketitle_title
\tl_new:N \g_@@_maketitle_author
\tl_new:N \g_@@_maketitle_date
%    \end{macrocode}
% \end{variable}

% \begin{imacro}{\title, \author, \date}
%    Store argument in an internal variable.
%    Store the argument in the traditional \tn{@title},
%    \tn{@author},
%    and \tn{@date} defined by the \LaTeX{} format
%    in case any packages expect them.
%    \begin{macrocode}
\RenewDocumentCommand{\title}{m}{
  \tl_gset:Nn \g_@@_maketitle_title {#1}
  \cs_gset:Npn \@title {#1}
}
\RenewDocumentCommand{\author}{m}{
  \tl_gset:Nn \g_@@_maketitle_author {#1}
  \cs_gset:Npn \@author {#1}
}
\RenewDocumentCommand{\date}{m}{
  \tl_gset:Nn \g_@@_maketitle_date {#1}
  \cs_gset:Npn \@date {#1}
}
%    \end{macrocode}
%    Initialize \cs{g_@@_maketitle_date} and \tn{@date} to today's date.
%    \begin{macrocode}
\date{\today}
%    \end{macrocode}
% \end{imacro}

% \begin{imacro}{\maketitle}
%    Prints article title at top of (next) page.
%    Implement using the macros provided by \LaTeX{}
%    and used by the standard classes,
%    in case any packages expect these.
%    \begin{macrocode}
\NewDocumentCommand{\maketitle}{}{
  \group_begin:
%    \end{macrocode}
%    Use symbols instead of numerals for footnotes in the title.
%    \begin{macrocode}
    \cs_set:Npn \thefootnote {\fnsymbol{footnote}}
%    \end{macrocode}
%    Typeset the footnote marks in a box of zero width
%    that protrudes to the right of the insertion point,
%    so that the centering of authors' names looks better.
%    \begin{macrocode}
    \cs_set_protected:Npn \@makefnmark {
      \hbox_overlap_right:n {\normalfont\textsuperscript\@thefnmark}
    }
%    \end{macrocode}
%    Start a new page,
%    prevent floats from appearing on the top of this page,
%    and print the title.
%    \begin{macrocode}
    \newpage
    \int_gset:Nn \@topnum {0}
    \@maketitle
%    \end{macrocode}
%    Set this page's style to \ps{plain},
%    and print footnotes with \tn{@thanks}.
%    \begin{macrocode}
    \thispagestyle{plain}
    \@thanks
%    \end{macrocode}
%    Close the group
%    and reset the footnote counter.
%    Disable commands that only make sense in \tn{maketitle},
%    like \tn{thanks} and \tn{and}.
%    Undefine other macros as in the standard classes,
%    in case any packages expect them to be undefined.
%    The variables \cs{g_@@_maketitle_title},
%    \cs{g_@@_maketitle_author},
%    and \cs{g_@@_maketitle_date}
%    defined by this class are still available.
%    \begin{macrocode}
  \group_end:

  \setcounter{footnote}{0}
  \cs_undefine:N \maketitle
  \cs_undefine:N \title
  \cs_undefine:N \author
  \cs_undefine:N \date
  \cs_undefine:N \thanks
  \cs_undefine:N \and
  \cs_undefine:N \@maketitle
  \cs_undefine:N \@title
  \cs_undefine:N \@author
  \cs_undefine:N \@date
  \cs_undefine:N \@thanks
}
%    \end{macrocode}
% \end{imacro}

% \begin{lmacro}{\@maketitle}
%    Handles the actual formatting of the title.
%    \begin{macrocode}
\cs_new_protected:Npn \@maketitle {
  \group_begin:
    \hbox_set:Nn \l_tmpa_box {\normalsize\normalfont\g_@@_maketitle_date}
    \dim_set:Nn \l_tmpa_dim {\box_ht:N \l_tmpa_box}

    \vbox_set:Nn \l_tmpb_box {
      \begin{center}
        \large\normalfont\headfamily
        \MakeUppercase{\tl_use:N \g_@@_maketitle_title}\par
        \skip_vertical:n {\baselineskip}
%    \end{macrocode}
%    If the \env{tabular} environment below contains one row,
%    its height is equal to the height of \tn{strutbox}
%    (which is \num{0.7}\tn{baselineskip})
%    and its depth is equal to the depth of \tn{strutbox}
%    (which is \num{0.3}\tn{baselineskip}).
%    If the \env{tabular} environment contains multiple rows,
%    its height stays the same,
%    but its depth increases by another \tn{baselineskip}.
%    Because its depth is larger than \tn{baselineskip},
%    it is less than \tn{lineskiplimit}
%    (which is \num{0}\unit{pt}, by default)
%    from the next box,
%    which means \tn{lineskip} is inserted
%    between the \env{tabular} environment and the next box
%    instead of \tn{baselineskip} minus the depth of the previous box
%    and minus the height of the next box.
%    Set \tn{lineskip} so that it is equal
%    to the \tn{baselineskip} glue that would have been added
%    if the \env{tabular} environment had consisted of one row:
%    \tn{baselineskip} minus the height of the next box
%    (saved in \cs{l_tmpa_dim})
%    minus what the depth of the previous box would have been
%    (which is the depth of \tn{strutbox}).
%    \begin{macrocode}
        \dim_set:Nn \lineskip {
          \baselineskip - (\l_tmpa_dim + \box_dp:N \strutbox)
        }
        \begin{tabular}[t]{c}
          \tl_use:N \g_@@_maketitle_author
        \end{tabular}\par
        \mode_leave_vertical: \box_use_drop:N \l_tmpa_box
      \end{center}
    }
%    \end{macrocode}
%    Save the total height of the title
%    so that we can calculate how much space to insert before the title
%    such that the total height of the space plus the title
%    is equal to some integer multiple of \tn{baselineskip}.
%    \begin{macrocode}
    \dim_set:Nn \l_tmpb_dim {\box_ht_plus_dp:N \l_tmpb_box}

    \RenewCommandCopy\footnote\thanks
%    \end{macrocode}
%    Set \bool{@nobreak} to \bool{true}
%    so that no extra space will be inserted
%    before an immediately subsequent section heading.
%    (As designed in this document class,
%    the text following the section heading
%    will still snap to baseline).
%    \begin{macrocode}
    \legacy_if_gset_true:n {@nobreak}

    \rule{0pt}{0pt}
    \skip_vertical:n {
      \fp_eval:n {ceil(\l_tmpb_dim / \baselineskip, 0)}\baselineskip
      - \l_tmpb_dim
    }
    % \ShowGrid{\l_tmpb_box}{\c_@@_large_leading_dim}{6.156pt}
    \box_use_drop:N \l_tmpb_box
    \skip_vertical:n {\baselineskip}
  \group_end:
}
%    \end{macrocode}
% \end{lmacro}

