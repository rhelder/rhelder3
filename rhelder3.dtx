% \begin{imacro}{\small}
%    Sets not only font size and leading,
%    display parameters and generic list parameters,
%    like \tn{normalsize} does.
%    \begin{macrocode}
\NewDocumentCommand{\small}{}{
  \@setfontsize\small\c_@@_small_size_dim\c_@@_small_leading_dim

  \skip_set:Nn \smallskipamount {0.5\baselineskip}
  \skip_set_eq:NN \medskipamount \baselineskip
  \skip_set:Nn \bigskipamount {2\baselineskip}

  \dim_set_eq:NN \abovedisplayskip \baselineskip
  \dim_set_eq:NN \belowdisplayskip \abovedisplayskip
  \dim_set:Nn \abovedisplayshortskip {0pt}
  \dim_set_eq:NN \belowdisplayshortskip \belowdisplayskip

  \cs_set_protected:Npn \@listi {
    \dim_set_eq:NN \leftmargin \leftmargini
    \skip_set:Nn \topsep {\c_@@_small_leading_dim}
    \skip_set:Nn \parsep {0pt}
    \skip_set:Nn \partopsep {0pt}
    \skip_set:Nn \itemsep {0pt}

    \group_begin:
      \bool_case:nT {
        {! \int_if_zero_p:n {\@enumdepth}}
          {\hbox_set:Nn \l_tmpa_box {\labelenumi}}
        {! \int_if_zero_p:n {\@itemdepth}}
          {\hbox_set:Nn \l_tmpa_box {\labelitemi}}
      }{
        \dim_gset:Nn \g_tmpa_dim {\box_wd:N \l_tmpa_box}
      }
    \group_end:

    \bool_if:nT {
      ! \int_if_zero_p:n {\@enumdepth} || ! \int_if_zero_p:n {\@itemdepth}
    }{
      \dim_set:Nn \labelsep {\leftmargin - \g_tmpa_dim}
      \dim_set:Nn \labelwidth {\leftmargin - \labelsep}
    }
  }
}
%    \end{macrocode}
% \end{imacro}

