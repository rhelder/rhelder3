\dim_new:N \g_@@_normal_size_dim
\dim_new:N \g_@@_normal_leading_dim
\dim_new:N \g_@@_large_size_dim
\dim_new:N \g_@@_large_leading_dim

\dim_set:Nn \g_@@_normal_size_dim {12pt}
\dim_set:Nn \g_@@_normal_leading_dim {15pt}
\dim_set:Nn \g_@@_large_size_dim {14pt}
\dim_set:Nn \g_@@_large_leading_dim {18pt}
