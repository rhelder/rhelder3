% \begin{imacro}{\ShowGrid}
%    \marg{vbox}\marg{step}\marg{yshift}\\
%    Overlay \meta{vbox} with horizontal lines separated by \meta{step}.
%    The first horizontal line is at \marg{yshift} from the top of the box.
%    \begin{macrocode}
\NewDocumentCommand{\ShowGrid}{mmm}{
  \vbox_set:Nn #1 {
    \skip_set:Nn \baselineskip {0pt}
    \skip_set:Nn \lineskip {0pt}
    \dim_set:Nn \lineskiplimit {0pt}
    \@@_showgrid_vbox_to_zero:n {#1}{#2}{#3}
    \box_use_drop:N #1
  }
}

\cs_new:Npn \@@_showgrid_vbox_to_zero:n #1#2#3 {
  \vbox_to_zero:n {
    \vbox_to_zero:n {
      \skip_vertical:n {#3}
      \vbox_to_zero:n {
        \vss
        \hrule height 0.2pt depth 0pt width \box_wd:N #1
      }

      \group_begin:
        \dim_set:Nn \l_tmpa_dim {#3}

        \dim_while_do:nNnn {\l_tmpa_dim} < {\box_ht:N #1} {
          \skip_vertical:n {#2}
          \vbox_to_zero:n {
            \vss
            \hrule height 0.2pt depth 0pt width \box_wd:N #1
          }
          \dim_add:Nn \l_tmpa_dim {#2}
        }
      \group_end:

      \vss
    }
  }
}
%    \end{macrocode}
% \end{imacro}

