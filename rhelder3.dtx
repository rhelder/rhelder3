% \section{Initialization}
%
% Provide the four things that a document class must provide:
% a definition of \tn{normalsize},
% values for \tn{textwidth} and \tn{textheight}
% and a specification for page-numbering.
% Provide these right away so that we can safely load required packages
% and execute options.
%
% \subsection{Leading}
%
% \begin{variable}{
%   \c_@@_normal_size_dim,
%   \c_@@_normal_leading_dim,
% }
%    Dimensions to be used by size-changing commands like \tn{normalsize}.
%    Will be set to \tn{baselineskip} by \tn{normalsize}.
%    \begin{macrocode}
\dim_new:N \c_@@_normal_size_dim
\dim_new:N \c_@@_normal_leading_dim

\dim_set:Nn \c_@@_normal_size_dim {12pt}
\dim_set:Nn \c_@@_normal_leading_dim {15pt}
%    \end{macrocode}
% \end{variable}

% \begin{imacro}{\normalsize}
%    Sets the font size and leading.
%    Also sets display parameters
%    and generic list parameters.
%    \begin{macrocode}
\RenewDocumentCommand{\normalsize}{}{
  \@setfontsize\normalsize\c_@@_normal_size_dim\c_@@_normal_leading_dim

  \skip_set:Nn \smallskipamount {0.5\baselineskip}
  \skip_set_eq:NN \medskipamount \baselineskip
  \skip_set:Nn \bigskipamount {2\baselineskip}

  \dim_set_eq:NN \abovedisplayskip \baselineskip
  \dim_set_eq:NN \belowdisplayskip \abovedisplayskip
  \dim_set:Nn \abovedisplayshortskip {0pt}
  \dim_set_eq:NN \belowdisplayshortskip \belowdisplayskip

  \cs_set_eq:NN \@listi \@listI
}
%    \end{macrocode}
% \end{imacro}

% Initialize font size and leading.
%    \begin{macrocode}
\normalsize
%    \end{macrocode}

% \begin{lmacro}{\@ptsize}
%    Contains the second digit of the type size.
%    Set for compatibility with packages that check this macro.
%    \begin{macrocode}
\cs_new:Npn \@ptsize{2}
%    \end{macrocode}
% \end{lmacro}

% \subsection{Font}
%
% With \tn{normalsize} defined,
% we can load \pkg{fontspec}
% and define the main font,
% so that \tn{textwidth} and \tn{textheight}
% can be calculated.
%    \begin{macrocode}
\RequirePackage{fontspec}

\setmainfont{EBGaramond}
%    \end{macrocode}

% \subsection{The Page}
%
% Abstract from \LaTeX{}'s counterintuitive layout parameters
% with the \pkg{geometry} package.
%
% Right now only letter paper is supported.
%    \begin{macrocode}
\RequirePackage[letterpaper]{geometry}
%    \end{macrocode}

% \subsubsection{Measure}
%
% \begin{imacro}{\SetTextwidth}
%    \marg{integer}\\
%    Sets \tn{textwidth}
%    so that the line will contain
%    an average of roughly \meta{integer} characters.
%    This formula for calculating the line width
%    is extracted from the copyfitting table at
%    \autocite[28]{bringhurst1992ElementsTypographic}.
%    \begin{macrocode}
\dim_new:N \l_@@_settextwidth_fontwidth_dim

\NewDocumentCommand{\SetTextwidth}{m}{
  \group_begin:
    \hbox_set:Nn \l_tmpa_box {abcdefghijklmnopqrstuvwxyz}
    \dim_set:Nn \l_@@_settextwidth_fontwidth_dim {\box_wd:N \l_tmpa_box}
    \dim_gset:Nn \textwidth {
      (0.0325\l_@@_settextwidth_fontwidth_dim + 0.378pt) * #1
    }
  \group_end:

  \geometry{textwidth = \textwidth}
}
%    \end{macrocode}
% \end{imacro}

% \subsubsection{Text Block}
%
% \begin{lskip}{\topskip}
%    Glue inserted before the first box on each page
%    (in other words,
%    the leading for the first line on the page).
%    \begin{macrocode}
\skip_set_eq:NN \topskip \c_@@_normal_size_dim
%    \end{macrocode}
% \end{lskip}

% \begin{ldimen}{\maxdepth}
%    \textcquote[113]{knuth1984TeXbook}[.]{^^A
%      Tells \TeX{} to raise the bottom box on the page
%      if that box has too much depth,
%      so that the depth of the constructed page
%      will not exceed a specified value^^A
%    }
%    Set this to half of \tn{topskip},
%    so that \tn{topskip} + \tn{maxdepth}
%    is equal to \num{1.5} times the type size,
%    as in the standard classes.
%    \begin{macrocode}
\skip_set:Nn \maxdepth {0.5\topskip}
%    \end{macrocode}
% \end{ldimen}

% \begin{imacro}{\SetTextheight}
%    \marg{ratio}\\
%    Set \(\sfrac{\tn{textheight}}{\tn{textwidth}}\)
%    to be equal to \meta{ratio}.
%    \begin{macrocode}
\int_new:N \l_@@_settextheight_lines_int

\NewDocumentCommand{\SetTextheight}{m}{
  \group_begin:
    \int_set:Nn \l_@@_settextheight_lines_int {
      \fp_to_int:n {
        (#1\textwidth - \topskip) / \baselineskip
      }
    }
    \dim_gset:Nn \textheight {
      \topskip + \l_@@_settextheight_lines_int\baselineskip
    }
  \group_end:

  \geometry{textheight = \textheight}
}
%    \end{macrocode}
% \end{imacro}

% Choose a proportion between text height and width
% that appealingly contrasts with the letter page height and width.
% A ratio of \num{1.701}
% (tall pentagon; see \autocite[150]{bringhurst1992ElementsTypographic})
% seems to work well.
%    \begin{macrocode}
\SetTextwidth{70}
\SetTextheight{1.701}
%    \end{macrocode}
%
% Set the bottom margin equal to the horizontal margin.
% This creates an appealing and undramatic
% approximately \num{2:3} ratio
% between the top and bottom margins,
% at least when the line accommodates 70 characters on average.
%    \begin{macrocode}
\geometry{
  hcentering,
  bmargin = \dim_eval:n {(\paperwidth - \textwidth) / 2}
}
%    \end{macrocode}

% \subsubsection{Page Numbering}
%
%    \begin{macrocode}
\geometry{footskip = 3\baselineskip}
\pagenumbering{arabic}
\pagestyle{plain}
%    \end{macrocode}

