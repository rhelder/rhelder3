% \subsection{Baseline Grid}
%
% \begin{macro}{\@@_show_baseline_grid:}
%    Typesets baseline grid.
%    Called if \opt{showgrid} is set.
%    \begin{macrocode}
\cs_new:Npn \@@_show_baseline_grid: {
  \dim_set:Nn \l_@@_to_first_baseline_dim {\Gm@tmargin + \topskip}
  \dim_set:Nn \l_@@_yshift_dim {
    \fp_eval:n {
      \fp_to_int:n {\l_@@_to_first_baseline_dim / \g_@@_normal_leading_dim} -
      \l_@@_to_first_baseline_dim / \g_@@_normal_leading_dim
    }\g_@@_normal_leading_dim
  }

  \hook_gput_code:nnn {shipout/background}{.}{
    \put (0, 0){
      \begin{tikzpicture}[remember~picture, overlay]
        \draw [ystep = \g_@@_normal_leading_dim, xstep = 0, help~lines]
          (0, 0) [yshift = \l_@@_yshift_dim] grid +(\pagewidth, -\pageheight);
      \end{tikzpicture}
    }
  }
}
%    \end{macrocode}
% \end{macro}

% \section{Blocks}
%
% \subsection{Parameters of Generic \env{list} Environment}
%
% \begin{ldimen}{\leftmargin, \leftmargini}
%    Align lists with the surrounding paragraph indent.
%    \begin{macrocode}
\dim_set_eq:NN \leftmargin \parindent
\dim_set_eq:NN \leftmargini \parindent
%    \end{macrocode}
% \end{ldimen}

% \begin{lmacro}{\@listi, \@listI}
%    Don't put any stretchable space between list elements,
%    and set \tn{topsep} to half a \tn{baselineskip},
%    so that the text will snap back to baseline after the end of the list.
%    \begin{macrocode}
\def\@listi{
  \dim_set_eq:NN \leftmargin \leftmargini
  \skip_set:Nn \topsep {0.5\g_@@_normal_leading_dim}
  \skip_set:Nn \parsep {0pt}
  \skip_set:Nn \itemsep {0pt}
}

\let\@listI\@listi

\@listi
%    \end{macrocode}
% \end{lmacro}

% \subsection{Block Environments Based on \env{list}}
%
% \begin{environment}{quotation, quote}
%    Define environments for setting block quotations.
%    Define both \env{quotation} and \env{quote},
%    as in the standard classes,
%    in case any packages expect one or the other.
%    \begin{macrocode}
\NewDocumentEnvironment{quotation}{}{
  \list{}{
    \dim_set:Nn \itemindent {0pt}
    \dim_set_eq:NN \listparindent \parindent
    \dim_set_eq:NN \rightmargin \leftmargin
  }
  \item\relax
}{
  \endlist
}

\NewEnvironmentCopy{quote}{quotation}
