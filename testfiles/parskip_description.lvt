\input{regression-test}

\ExplSyntaxOn
\debug_on:n {check-declarations, deprecation}
% Define boolean that is not declared by a dependency of adforn
\bool_new:N \l__fixtounicode_luatex_has_fix_bool
\ExplSyntaxOff

\documentclass[kant]{rhelder3handout}

\ExplSyntaxOn
\NewDocumentCommand{\test}{+m}{
  \vbox_set:Nn \l_tmpa_box {#1}
  \box_show:N \l_tmpa_box
}
\ExplSyntaxOff

\begin{document}
\START

\TEST{description within paragraph}{%
  \test{%
    \autokant*[1][1]
    \begin{description}
      \item[The Ideal] \autokant[1][1]
      \item[Practical Reason] \autokant[0][1]
      \item[The Categories] \autokant[0][1]
    \end{description}
    \autokant[1][1]%
  }%
}

\TEST{description in new paragraph}{%
  \test{%
    \autokant[1][1]\par
    \begin{description}
      \item[The Ideal] \autokant[1][1]
      \item[Practical Reason] \autokant[0][1]
      \item[The Categories] \autokant[0][1]
    \end{description}\par
    \autokant[1][1]%
  }%
}

\TEST{New paragraph in description item}{%
  \test{%
    \autokant*[1][1]
    \begin{description}
      \item[The Ideal] \autokant[1][1]\autokant[1][1]
      \item[Practical Reason] \autokant[1][1]\autokant[1][1]
      \item[The Categories] \autokant[1][1]\autokant[1][1]
    \end{description}
    \autokant[1][1]%
  }%
}

\END
