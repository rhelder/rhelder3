\input{regression-test}

\ExplSyntaxOn
\debug_on:n {check-declarations, deprecation}
% Define boolean that is not declared by a dependency of adforn
\bool_new:N \l__fixtounicode_luatex_has_fix_bool
\ExplSyntaxOff

\documentclass[kant]{rhelder3handout}

\ExplSyntaxOn
\ProvideDocumentCommand{\test}{+m}{
  \vbox_set:Nn \l_tmpa_box {#1}
  \box_show:N \l_tmpa_box
}
\ExplSyntaxOff

\begin{document}
\START

\TEST{quotation within paragraph}{%
  \test{%
    \autokant*[1][1]
    \begin{quotation}
      \autokant[0][2]
    \end{quotation}
    \autokant[0][1]%
  }%
}

\TEST{quotation in new paragraph}{%
  \test{%
    \autokant[1][1]\par
    \begin{quotation}
      \autokant[0][2]
    \end{quotation}\par
    \autokant[1][1]%
  }%
}

\TEST{New paragraph in quotation}{%
  \test{%
    \autokant*[1][1]
    \begin{quotation}
      \autokant[0][1]
      \autokant[1][1]
    \end{quotation}
    \autokant[0][1]%
  }%
}

\END
