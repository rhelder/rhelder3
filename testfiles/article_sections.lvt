\input{regression-test}

\ExplSyntaxOn
\debug_on:n {check-declarations, deprecation}
% Define boolean that is not declared by a dependency of adforn
\bool_new:N \l__fixtounicode_luatex_has_fix_bool
\ExplSyntaxOff

\documentclass[kant]{rhelder3}

\ExplSyntaxOn
\NewDocumentCommand{\test}{+m}{
  \vbox_set:Nn \l_tmpa_box {#1}
  \box_show:N \l_tmpa_box
}
\ExplSyntaxOff

\begin{document}
\START

\TEST{section}{%
  \test{%
    \autokant[1][1]
    \kantsection
    \autokant[1][1]%
  }%
}

\TEST{subsection}{%
  \test{%
    \autokant[1][1]
    \kantsubsection
    \autokant[1][1]%
  }%
}

\TEST{subsubsection}{%
  \test{%
    \autokant[1][1]
    \kantsubsubsection
    \autokant[1][1]%
  }%
}

\TEST{paragraph}{%
  \test{%
    \autokant[1][1]
    \kantparagraph
    \autokant[1][1]%
  }%
}

\TEST{subparagraph}{%
  \test{%
    \autokant[1][1]
    \kantsubparagraph
    \autokant[1][1]%
  }%
}

\TEST{Nested sections}{%
  \test{%
    \autokant[1][1]
    \section{Nested Sections}
    \subsection{Nested Subections}
    \subsubsection{Nested Subsubsections}
    \autokant[1][1]%
  }%
}

\END
