\input{regression-test}

\ExplSyntaxOn
\debug_on:n {check-declarations, deprecation}
% Define boolean that is not declared by a dependency of adforn
\bool_new:N \l__fixtounicode_luatex_has_fix_bool
\ExplSyntaxOff

\documentclass[kant]{rhelder3}

\ExplSyntaxOn
\NewDocumentCommand{\test}{+m}{
  \vbox_set:Nn \l_tmpa_box {#1}
  \box_show:N \l_tmpa_box
}
\ExplSyntaxOff

\begin{document}
\START

\TEST{enumerate within paragraph}{%
  \test{%
    \autokant*[1][1]
    \begin{enumerate}
      \item \autokant[1][1]
      \item \autokant[1][1]
      \item \autokant[1][1]
    \end{enumerate}
    \autokant[1][1]%
  }%
}

\TEST{enumerate in new paragraph}{%
  \test{%
    \autokant[1][1]\par
    \begin{enumerate}
      \item \autokant[1][1]
      \item \autokant[1][1]
      \item \autokant[1][1]
    \end{enumerate}\par
    \autokant[1][1]%
  }%
}

\TEST{New paragraph in enumerate item}{%
  \test{%
    \autokant*[1][1]
    \begin{enumerate}
      \item \autokant[1][1]\autokant[1][1]
      \item \autokant[1][1]\autokant[1][1]
      \item \autokant[1][1]\autokant[1][1]
    \end{enumerate}
    \autokant[1][1]%
  }%
}

\TEST{Nested enumerate}{%
  \test{%
    \autokant*[1][1]
    \begin{enumerate}
      \item \autokant[1][1]
        \begin{enumerate}
          \item \autokant[0][1]\autokant[1][1]
            \begin{enumerate}
              \item \autokant[0][1]
                \begin{enumerate}
                  \item \autokant[0][1]
                  \item \autokant[1][1]
                \end{enumerate}
              \item \autokant[0][1]
            \end{enumerate}
          \item \autokant[0][1]
        \end{enumerate}
      \item \autokant[0][1]
    \end{enumerate}
    \autokant[1][1]%
  }%
}

\END
